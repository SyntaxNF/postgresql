# https://www.postgresql.org/docs/18/sql-createcollation.html

# CASE PARAMETERS
CREATE COLLATION [ IF NOT EXISTS ] name (
    [ LOCALE = locale, ]
    [ LC_COLLATE = lc_collate, ]
    [ LC_CTYPE = lc_ctype, ]
    [ PROVIDER = provider, ]
    [ DETERMINISTIC = deterministic, ]
    [ RULES = rules, ]
    [ VERSION = version, ]
)

# CASE COPY
CREATE COLLATION [ IF NOT EXISTS ] name
    FROM collation
