# https://www.postgresql.org/docs/18/sql-createfunction.html

CREATE [ OR REPLACE ] FUNCTION name (
    [ argument_definition [, ...] ]
)
    [ RETURNS [ SETOF ] type | RETURNS TABLE ( table_column_definition [, ...] ) ]
    [ LANGUAGE language ]
    [ TRANSFORM { FOR TYPE type } [, ...] ]
    [ WINDOW ]
    [ IMMUTABLE | STABLE | VOLATILE ]
    [ [ NOT ] LEAKPROOF ]
    [ STRICT | CALLED ON NULL INPUT | RETURNS NULL ON NULL INPUT ]
    [ [ EXTERNAL ] SECURITY { INVOKER | DEFINER } ]
    [ PARALLEL { UNSAFE | RESTRICTED | SAFE } ]
    [ COST cost ]
    [ ROWS rows ]
    [ SUPPORT support ]
    [ set_parameter_clause [...] ]
    [ routine_body_clause ]

# WHERE argument_definition
[ IN | OUT | INOUT | VARIADIC ] [ argname ] argtype
[ { DEFAULT | = } value_expression ]

# WHERE table_column_definition
colname coltype

# WHERE set_parameter_clause
SET config_parameter { TO value | = value | FROM CURRENT }

# PARTOFIS routine_body_clause
AS 'definition'

AS 'object_file', 'link_symbol'

RETURN value_expression

BEGIN ATOMIC
    sql_statement [; ...] ;
END

# STATEMENT sql_statement
