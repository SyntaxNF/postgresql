# https://www.postgresql.org/docs/18/sql-createtable.html

# CASE NORMAL
CREATE [ TEMPORARY | TEMP | UNLOGGED ] TABLE [ IF NOT EXISTS ] name (
    {
        column_definition |
        table_constraint_definition |
        LIKE like_table [ like_option ]
    } [, ...]
)
    [ INHERITS ( inherits [, ...] ) ]
    [ PARTITION BY { RANGE | LIST | HASH } ( partition_column_expression [, ...] ) ]
    [ USING index_method ]
    [ WITH ( { storage_parameter [= value] } [, ...] ) ]
    [ ON COMMIT { PRESERVE ROWS | DELETE ROWS | DROP } ]
    [ TABLESPACE tablespace ]

# CASE TYPE
CREATE [ TEMPORARY | TEMP | UNLOGGED ] TABLE [ IF NOT EXISTS ] name OF type
    [ ( {
        typed_column_definition |
        table_constraint_definition
    } [, ...] ) ]
    [ PARTITION BY { RANGE | LIST | HASH } ( partition_column_expression [, ...] ) ]
    [ USING index_method ]
    [ WITH ( { storage_parameter [= value] } [, ...] ) ]
    [ ON COMMIT { PRESERVE ROWS | DELETE ROWS | DROP } ]
    [ TABLESPACE tablespace ]

# CASE PARTITION
CREATE [ TEMPORARY | TEMP | UNLOGGED ] TABLE [ IF NOT EXISTS ] name PARTITION OF parent
    [ ( {
        partition_column_definition |
        table_constraint_definition
    } [, ...] ) ]
    { FOR VALUES partition_bound_definition | DEFAULT }
    [ PARTITION BY { RANGE | LIST | HASH } ( partition_column_expression [, ...] ) ]
    [ USING index_method ]
    [ WITH ( { storage_parameter [= value] } [, ...] ) ]
    [ ON COMMIT { PRESERVE ROWS | DELETE ROWS | DROP } ]
    [ TABLESPACE tablespace ]

# WHERE column_definition
colname type [ STORAGE { PLAIN | EXTERNAL | EXTENDED | MAIN | DEFAULT } ]
[ COMPRESSION compression ] [ COLLATE collate ]
[ column_constraint_definition [...] ]

# WHERE like_option
{ INCLUDING | EXCLUDING } { COMMENTS | COMPRESSION | CONSTRAINTS | DEFAULTS | GENERATED | IDENTITY | INDEXES | STATISTICS | STORAGE | ALL }

# WHERE typed_column_definition
colname [ WITH OPTIONS ]
[ column_constraint_definition [...] ]

# WHERE partition_column_definition
colname [ WITH OPTIONS ] 
[ column_constraint_definition [...] ]

# ONEOFIS partition_bound_definition
  IN ( partition_bound_expression [, ...] )
FROM ( { partition_bound_expression | MINVALUE | MAXVALUE } [, ...] ) TO ( { partition_bound_expression | MINVALUE | MAXVALUE } [, ...] )
WITH ( MODULUS modulus, REMAINDER remainder )

# WHERE partition_column_expression
{ colname | ( col_expression ) } [ COLLATE collate ] [ opclass ]

# WHERE column_constraint_definition
[ CONSTRAINT constraint ]
{
NULL |
NOT NULL [ NO INHERIT ] |
DEFAULT value_expression |
GENERATED ALWAYS AS ( generated_expression ) [ STORED | VIRTUAL ] |
GENERATED { ALWAYS | BY DEFAULT } AS IDENTITY [ ( identity_options ) ] |
PRIMARY KEY primary_key_index_options |
UNIQUE [ NULLS [ NOT ] DISTINCT ] unique_index_options |
CHECK ( boolean_expression ) [ NO INHERIT ] |
REFERENCES referenced_table [ ( refcolname ) ]
    [ MATCH FULL | MATCH PARTIAL | MATCH SIMPLE ]
    [ ON DELETE on_delete_action ]
    [ ON UPDATE on_update ] 
}
[ DEFERRABLE | NOT DEFERRABLE ] [ INITIALLY DEFERRED | INITIALLY IMMEDIATE ] [ ENFORCED | NOT ENFORCED ]

# WHERE table_constraint_definition
[ CONSTRAINT constraint ]
{
CHECK ( boolean_expression ) [ NO INHERIT ] |
NOT NULL colname [ NO INHERIT ] |
UNIQUE [ NULLS [ NOT ] DISTINCT ] ( colname [, ...] [ WITHOUT OVERLAPS ] )
unique_index_options |
PRIMARY KEY ( colname [, ...] [ WITHOUT OVERLAPS ] )
primary_key_index_options |
EXCLUDE [ USING index_method ] (
    { colname | ( col_expression ) } [ COLLATE collate ]
    [ opclass [ ( { opclass_parameter = value } [, ...] ) ] ]
    [ ASC | DESC ] [ NULLS { FIRST | LAST } ] WITH operator [, ...] 
)
exclude_index_options
[ WHERE ( boolean_expression ) ] |
FOREIGN KEY ( colname [, ...] [, PERIOD colname ] )
REFERENCES referenced_table
[ ( refcolname [, ...] [, PERIOD refcolname ] ) ]
[ MATCH FULL | MATCH PARTIAL | MATCH SIMPLE ]
[ ON DELETE on_delete_action ]
[ ON UPDATE on_update_action ] 
}
[ DEFERRABLE | NOT DEFERRABLE ] [ INITIALLY DEFERRED | INITIALLY IMMEDIATE ] [ ENFORCED | NOT ENFORCED ]

# WHERE unique_index_options, primary_key_index_options, exclude_index_options
[ INCLUDE ( include [, ...] ) ]
[ WITH ( { storage_parameter [= value] } [, ...] ) ]
[ USING INDEX TABLESPACE tablespace ]

# WHERE on_delete_action, on_update_action
{ NO ACTION | RESTRICT | CASCADE | SET NULL [ ( colname [, ...] ) ] | SET DEFAULT [ ( colname [, ...] ) ] }
