# https://www.postgresql.org/docs/18/sql-createopclass.html

CREATE OPERATOR CLASS name [ DEFAULT ]
    FOR TYPE type
    USING index_method [ FAMILY family ] AS
    { operator_definition | function_definition } [, ...]
    [ STORAGE storage ]

# WHERE operator_definition
OPERATOR number operator
[ ( left, right ) ] [ FOR SEARCH | FOR ORDER BY order ]

# WHERE function_definition
FUNCTION number
[ ( left [, right ] ) ]
func ( argtype [, ...] )
