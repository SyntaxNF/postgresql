# https://www.postgresql.org/docs/18/sql-createpublication.html

CREATE PUBLICATION name
    [ FOR ALL TABLES | FOR publication_object [, ...] ]
    [ WITH ( { publication_parameter [= value] } [, ...] ) ]

# PARTOFIS publication_object
TABLE table_definition [, ...]

TABLES IN SCHEMA { schema | CURRENT_SCHEMA } [, ...]

# WHERE table_definition
[ ONLY ] table [ * ] [ ( colname [, ...] ) ] [ WHERE ( boolean_expression ) ]
