# https://www.postgresql.org/docs/18/sql-explain.html

EXPLAIN [ ( explain_options ) ]
    explainable_statement

# WHERE explain_options
[ ANALYZE [ analyze ], ]
[ VERBOSE [ verbose ], ]
[ COSTS [ costs ], ]
[ SETTINGS [ settings ], ]
[ GENERIC_PLAN [ generic_plan ], ]
[ BUFFERS [ buffers ], ]
[ SERIALIZE [ { NONE | TEXT | BINARY } ], ]
[ WAL [ wal ], ]
[ TIMING [ timing ], ]
[ SUMMARY [ summary ], ]
[ MEMORY [ memory ], ]
[ FORMAT { TEXT | XML | JSON | YAML }, ]

# STATEMENT explainable_statement
SELECT
TABLE
VALUES
INSERT
UPDATE
DELETE
MERGE
EXECUTE
DECLARE
CREATE TABLE AS
CREATE MATERIALIZED VIEW
