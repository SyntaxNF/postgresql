# https://www.postgresql.org/docs/18/sql-analyze.html

ANALYZE [ ( analyze_options ) ] table_expression [, ...]

# WHERE analyze_options
[ VERBOSE [ verbose ], ]
[ SKIP_LOCKED [ skip_locked ], ]
[ BUFFER_USAGE_LIMIT buffer_usage_limit, ]

# WHERE table_expression
[ ONLY ] name [ * ] [ ( colname [, ...] ) ]
