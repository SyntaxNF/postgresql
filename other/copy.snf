# https://www.postgresql.org/docs/18/sql-copy.html

# CASE FROM
COPY table [ ( colname [, ...] ) ]
    FROM { 'file' | PROGRAM 'command' | STDIN }
    [ [ WITH ] ( copy_from_options ) ]
    [ WHERE boolean_expression ]

# CASE TO
COPY { table [ ( colname [, ...] ) ] | ( query_statement ) }
    TO { 'file' | PROGRAM 'command' | STDOUT }
    [ [ WITH ] ( copy_to_options ) ]

# WHERE copy_from_options
[ FORMAT { TEXT | CSV | BINARY }, ]
[ FREEZE [ freeze ], ]
[ DELIMITER 'delimiter', ]
[ NULL 'null', ]
[ DEFAULT 'default', ]
[ HEADER [ header | MATCH ], ]
[ QUOTE 'quote', ]
[ ESCAPE 'escape', ]
[ FORCE_NOT_NULL { ( colname [, ...] ) | * }, ]
[ FORCE_NULL { ( colname [, ...] ) | * }, ]
[ ON_ERROR { STOP | IGNORE }, ]
[ REJECT_LIMIT reject_limit, ]
[ ENCODING 'encoding', ]
[ LOG_VERBOSITY { DEFAULT | VERBOSE | SILENT }, ]

# WHERE copy_to_options
[ FORMAT { TEXT | CSV | BINARY }, ]
[ DELIMITER 'delimiter', ]
[ NULL 'null', ]
[ HEADER [ header ], ]
[ QUOTE 'quote', ]
[ ESCAPE 'escape', ]
[ FORCE_QUOTE { ( colname [, ...] ) | * }, ]
[ ENCODING 'encoding', ]

# STATEMENT query_statement
SELECT
TABLE
VALUES
INSERT
UPDATE
DELETE
MERGE
