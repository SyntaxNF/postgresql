# https://www.postgresql.org/docs/18/sql-security-label.html

SECURITY LABEL [ FOR provider ]
    ON label_target
    IS { 'string' | NULL }

# PARTOFIS label_target
TABLE table

COLUMN table.colname

AGGREGATE aggregate (
    signature
)

DATABASE database

DOMAIN domain

EVENT TRIGGER event_trigger

FOREIGN TABLE foreign_table

FUNCTION function
    [ ( argtype [, ...] ) ]

LARGE OBJECT large_object

MATERIALIZED VIEW m_view

[ PROCEDURAL ] LANGUAGE language

PROCEDURE procedure
    [ ( argtype [, ...] ) ]

PUBLICATION publication

ROLE role

ROUTINE routine
    [ ( argtype [, ...] ) ]

SCHEMA schema

SEQUENCE sequence

SUBSCRIPTION subscription

TABLESPACE tablespace

TYPE type

VIEW view

# PARTOFIS signature
*

arg [, ...]

arg [, ...]
ORDER BY orders [, ...]

# WHERE arg, orders
[ argmode ] [ argname ] argtype
