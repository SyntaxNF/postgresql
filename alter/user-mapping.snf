# https://www.postgresql.org/docs/18/sql-alterusermapping.html

ALTER USER MAPPING FOR role_public
    SERVER server
    OPTIONS ( option_action [, ...] )

# PARTOFIS option_action
[ ADD | SET ] option 'value'

DROP option

# WHERE role_public
{ role_name | USER | CURRENT_ROLE | CURRENT_USER | SESSION_USER | PUBLIC }
