# https://www.postgresql.org/docs/18/sql-alterpublication.html

# CASE ADD
ALTER PUBLICATION name
    ADD publication_object [, ...]

# CASE DROP
ALTER PUBLICATION name
    DROP publication_object [, ...]

# CASE RENAME
ALTER PUBLICATION name
    RENAME TO new_name

# CASE SET_TABLES
ALTER PUBLICATION name
    SET publication_object [, ...]

# CASE SET_OPTIONS
ALTER PUBLICATION name
    SET ( { publication_parameter [= value] } [, ...] )

# CASE OWNER
ALTER PUBLICATION name OWNER TO role

# PARTOFIS publication_object
TABLE table_definition [, ...]

TABLES IN SCHEMA { schema | CURRENT_SCHEMA } [, ...]

# WHERE table_definition
[ ONLY ] table [ * ] [ ( colname [, ...] ) ] [ WHERE ( boolean_expression ) ]

# WHERE role
{ role_name | CURRENT_ROLE | CURRENT_USER | SESSION_USER }
