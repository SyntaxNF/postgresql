# https://www.postgresql.org/docs/18/sql-alterserver.html

# CASE OPTIONS
ALTER SERVER name
    [ VERSION 'version' ]
    [ OPTIONS ( option_action [, ...] ) ]

# CASE RENAME
ALTER SERVER name RENAME TO new_name

# CASE OWNER
ALTER SERVER name OWNER TO role

# WHERE option_action
[ ADD | SET | DROP ] option ['value']

# WHERE role
{ role_name | CURRENT_ROLE | CURRENT_USER | SESSION_USER }
