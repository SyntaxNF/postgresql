# https://www.postgresql.org/docs/18/sql-alteraggregate.html

# CASE RENAME
ALTER AGGREGATE name (
    signature
) RENAME TO new_name

# CASE OWNER
ALTER AGGREGATE name (
    signature
) OWNER TO role

# CASE SCHEMA
ALTER AGGREGATE name (
    signature
) SET SCHEMA schema

# PARTOFIS signature
*

arg [, ...]

arg [, ...]
ORDER BY orders [, ...]

# WHERE arg, order
[ argmode ] [ argname ] argtype

# WHERE role
{ role_name | CURRENT_ROLE | CURRENT_USER | SESSION_USER }
