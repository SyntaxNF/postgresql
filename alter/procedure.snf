# https://www.postgresql.org/docs/18/sql-alterprocedure.html

# CASE OPTIONS
ALTER PROCEDURE name
    [ ( [ arg [, ...] ] ) ]
    action
    [ RESTRICT ]

# CASE RENAME
ALTER PROCEDURE name
    [ ( [ arg [, ...] ] ) ]
    RENAME TO new_name

# CASE OWNER
ALTER PROCEDURE name
    [ ( [ arg [, ...] ] ) ]
    OWNER TO role

# CASE SCHEMA
ALTER PROCEDURE name
    [ ( [ arg [, ...] ] ) ]
    SET SCHEMA schema

# CASE DEPENDS_EXTENSION
ALTER PROCEDURE name
    [ ( [ arg [, ...] ] ) ]
    [ NO ] DEPENDS
    ON EXTENSION extension

# WHERE action
[ [ EXTERNAL ] SECURITY INVOKER | [ EXTERNAL ] SECURITY DEFINER ]
[ set_parameter_clause [...] ]
[ reset_parameter_clause [...] ]
[ RESET ALL ]

# WHERE arg
[ argmode ] [ argname ] argtype

# WHERE role
{ role_name | CURRENT_ROLE | CURRENT_USER | SESSION_USER }

# WHERE set_parameter_clause
SET config_parameter { { TO | = } { value | DEFAULT } | FROM CURRENT }

# WHERE reset_parameter_clause
RESET config_parameter
