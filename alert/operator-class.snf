# https://www.postgresql.org/docs/18/sql-alteropclass.html

# CASE RENAME
ALTER OPERATOR CLASS name USING index_method RENAME TO new_name

# CASE OWNER
ALTER OPERATOR CLASS name USING index_method OWNER TO role

# CASE SCHEMA
ALTER OPERATOR CLASS name USING index_method SET SCHEMA schema

# WHERE role
{ role_name | CURRENT_ROLE | CURRENT_USER | SESSION_USER }
