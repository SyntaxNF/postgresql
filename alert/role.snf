# https://www.postgresql.org/docs/18/sql-alterrole.html

# CASE OPTIONS
ALTER ROLE role [ WITH ]
    [ SUPERUSER | NOSUPERUSER ]
    [ CREATEDB | NOCREATEDB ]
    [ CREATEROLE | NOCREATEROLE ]
    [ INHERIT | NOINHERIT ]
    [ LOGIN | NOLOGIN ]
    [ REPLICATION | NOREPLICATION ]
    [ BYPASSRLS | NOBYPASSRLS ]
    [ CONNECTION LIMIT connection_limit ]
    [ [ ENCRYPTED ] PASSWORD 'password' | PASSWORD NULL ]
    [ VALID UNTIL 'timestamp' ]

# CASE RENAME
ALTER ROLE name RENAME TO new_name

# CASE SET_CURRENT
ALTER ROLE { role | ALL }
    [ IN DATABASE database ]
    SET config_parameter FROM CURRENT

# CASE SET
ALTER ROLE { role | ALL }
    [ IN DATABASE database ]
    SET config_parameter { TO | = } { value | DEFAULT }

# CASE RESET
ALTER ROLE { role | ALL }
    [ IN DATABASE database ]
    RESET config_parameter

# CASE RESET_ALL
ALTER ROLE { role | ALL }
    [ IN DATABASE database ]
    RESET ALL

# WHERE role
{ role_name | CURRENT_ROLE | CURRENT_USER | SESSION_USER }
