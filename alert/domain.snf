# https://www.postgresql.org/docs/18/sql-alterdomain.html

# CASE ADD_CONSTRAINT
ALTER DOMAIN name
    ADD [ CONSTRAINT constraint ] { NOT NULL | CHECK ( boolean_expression ) }
    [ NOT VALID ]

# CASE DROP_DEFAULT
ALTER DOMAIN name DROP DEFAULT

# CASE DROP_NOT_NULL
ALTER DOMAIN name DROP NOT NULL

# CASE DROP_CONSTRAINT
ALTER DOMAIN name DROP CONSTRAINT [ IF EXISTS ] constraint
    [ RESTRICT | CASCADE ]

# CASE RENAME_CONSTRAINT
ALTER DOMAIN name RENAME CONSTRAINT constraint TO new_constraint

# CASE VALIDATE_CONSTRAINT
ALTER DOMAIN name VALIDATE CONSTRAINT constraint

# CASE SET_DEFAULT
ALTER DOMAIN name SET DEFAULT value_expression

# CASE SET_NOT_NULL
ALTER DOMAIN name SET NOT NULL

# CASE RENAME
ALTER DOMAIN name RENAME TO new_name

# CASE OWNER
ALTER DOMAIN name OWNER TO role

# CASE SCHEMA
ALTER DOMAIN name SET SCHEMA schema

# WHERE role
{ role_name | CURRENT_ROLE | CURRENT_USER | SESSION_USER }
