# https://www.postgresql.org/docs/18/sql-alterview.html

# CASE SET_DEFAULT
ALTER VIEW [ IF EXISTS ] name
    ALTER [ COLUMN ] colname SET DEFAULT value_expression

# CASE DROP_DEFAULT
ALTER VIEW [ IF EXISTS ] name ALTER [ COLUMN ] colname DROP DEFAULT

# CASE RENAME_COLUMN
ALTER VIEW [ IF EXISTS ] name RENAME [ COLUMN ] colname TO new_colname

# CASE RENAME
ALTER VIEW [ IF EXISTS ] name RENAME TO new_name

# CASE SET_OPTIONS
ALTER VIEW [ IF EXISTS ] name SET ( { view_parameter [= value] } [, ...] )

# CASE RESET_OPTIONS
ALTER VIEW [ IF EXISTS ] name RESET ( view_parameter [, ...] )

# CASE OWNER
ALTER VIEW [ IF EXISTS ] name OWNER TO role

# CASE SCHEMA
ALTER VIEW [ IF EXISTS ] name SET SCHEMA schema

# WHERE role
{ role_name | CURRENT_ROLE | CURRENT_USER | SESSION_USER }
